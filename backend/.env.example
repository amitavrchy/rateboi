# ---------- Core ----------
NODE_ENV=development
PORT=4010
APP_URL=http://localhost:3010
API_URL=http://localhost:4010
CORS_ORIGINS=http://localhost:3010,http://localhost:8081
DATABASE_URL=postgresql://rateboi:local-development-only@localhost:5560/rateboi
# Leave REDIS_URL empty to run without queues (jobs then run in-process; dev only).
REDIS_URL=redis://localhost:6390
RUN_WORKER=true

# ---------- Auth ----------
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
OTP_TTL_SECONDS=300
# HMAC pepper for customer phone hashing (cross-merchant risk lookups). Never rotate without re-hash job.
PHONE_HASH_PEPPER=replace-with-32-random-bytes-hex
# AES-256-GCM key (base64, 32 bytes) for courier credentials / channel tokens. Use KMS in prod.
CREDENTIALS_ENC_KEY=replace-with-base64-32-bytes
CREDENTIALS_KEY_ID=local-1

# ---------- Couriers (platform-level; merchant credentials live encrypted in DB) ----------
COURIER_MODE=sandbox
REDX_BASE_URL=https://sandbox.redx.com.bd/v1.0.0-beta
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
PATHAO_BASE_URL=   # verify sandbox URL in Pathao merchant docs
PAPERFLY_BASE_URL= # verify
COURIER_POLL_STALE_HOURS=12
BOOKING_LOCK_SECONDS=60

# ---------- Payments (RateBoi subscriptions) ----------
PAYMENT_MODE=sandbox
BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# ---------- Messaging ----------
SMS_DRIVER=console
# SMS_API_URL=
# SMS_API_KEY=
# SMS_SENDER_ID=
WHATSAPP_DRIVER=console
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# META_APP_SECRET=
PUSH_DRIVER=console
# EXPO_ACCESS_TOKEN=

# ---------- AI ----------
AI_PROVIDER=mock   # mock | openai-compatible | other
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_MONTHLY_FREE_PARSES=50

# ---------- Storage ----------
STORAGE_DRIVER=local
# S3_BUCKET=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---------- Rate limits ----------
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10
RISK_CHECKS_PER_DAY_FREE=20
